# ==============================================================================
# CONFIGURATION DES SECRETS & POSTULATION AUTOMATIQUE (PFE HUNTER AGENT)
# Copiez ce fichier vers .env pour une utilisation locale, ou configurez ces variables
# dans GitHub: Settings > Secrets and variables > Actions > New repository secret
# ==============================================================================

# 1. Envoi Automatique d'E-mails (Multi-Canal)
# Option A (Recommandé Cloud Free Tier) : Resend API (3000 emails/mois gratuits sur resend.com)
RESEND_API_KEY=re_votre_cle_api_resend_ici
RESEND_FROM_EMAIL=onboarding@resend.dev

# Option B (Fallback Local / SMTP) : Gmail SMTP
GMAIL_USER=anas.mouqine@gmail.com
# Mot de passe d'application Google (16 lettres, généré sur https://myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=votre_mot_de_passe_application_16_lettres

# 2. Postulation Automatique Multi-Plateforme (Navigateur Cloud Headless)
# A. LinkedIn Easy Apply (0$ Cloud)
# Cookie de session 'li_at' extrait depuis votre navigateur (aucun identifiant/mot de passe requis)
LINKEDIN_LI_AT=

# B. ReKrute.com (Compte candidat pour postuler en 1-clic)
REKRUTE_EMAIL=anas.mouqine@gmail.com
REKRUTE_PASSWORD=

# C. Activation Globale de la Postulation Automatisée (LinkedIn, ReKrute, MarocAnnonces, Web Forms)
AUTO_PLATFORM_APPLY=false
AUTO_EASY_APPLY=false

# 3. Sécurité : Mettre à 'false' pour activer l'envoi réel, ou 'true' pour tester en simulation
DRY_RUN=true

# 4. Canaux de Notification Temps Réel (Optionnel mais recommandé)
# Obtenu via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=
# Obtenu via @userinfobot sur Telegram
TELEGRAM_CHAT_ID=

# URL de webhook d'un salon privé Discord
DISCORD_WEBHOOK_URL=

# 5. Intelligence Artificielle (Optionnel - pour enrichissement sémantique futur)
GEMINI_API_KEY=
